VITE_SUPABASE_URL=https://vxrgezyfxzynpucuomci.supabase.co
VITE_SUPABASE_ANON_KEY=<kunci-anon-anda>
# Kunci AES untuk NIK PPDB (js/ppdb/db.js). Ikut tertanam di bundle, jadi JANGAN taruh di .env
# (Vite memuat .env di semua mode, termasuk build produksi).
#  - Lokal/dev : simpan di .env.development.local (diabaikan git, hanya dimuat `npm run dev`).
#  - Produksi  : GitHub Secret VITE_ENCRYPTION_KEY (lihat .github/workflows/deploy.yml).
#  - Rotasi    : kunci lama ke VITE_ENCRYPTION_KEY_LEGACY agar NIK lama tetap terbaca.
VITE_ENCRYPTION_KEY=your-encryption-key-placeholder
VITE_ENCRYPTION_KEY_LEGACY=

VITE_ANALYTICS_PROVIDER=
VITE_SENTRY_DSN=
VITE_LOGROCKET_ID=
